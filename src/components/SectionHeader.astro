---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  id?: string;
}

const { title, subtitle, eyebrow, id } = Astro.props;
---

<header id={id} class="mb-7 sm:mb-10 reveal">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  <slot />
  {subtitle && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">{subtitle}</p>}
</header>

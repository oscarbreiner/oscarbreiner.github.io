---
interface Props {
  tags: string[];
  targetId: string;
}

const { tags, targetId } = Astro.props;
const base = 'tag-filter-btn rounded-full border px-3.5 py-1.5 text-xs font-semibold transition';
const active = ['border-accent', 'bg-accent', 'text-accent-fg'];
const inactive = ['border-border', 'bg-surface', 'text-muted', 'hover:border-ink/40', 'hover:text-ink'];
---

<div class="mb-8 flex flex-wrap gap-2" data-tag-filter data-target={targetId}>
  <button type="button" data-tag="all" class:list={[base, active]} aria-pressed="true">All</button>
  {tags.map((tag) => (
    <button type="button" data-tag={tag.toLowerCase()} class:list={[base, inactive]} aria-pressed="false">
      {tag}
    </button>
  ))}
</div>

<script define:vars={{ active, inactive }}>
  const syncButtons = (container, activeTag) => {
    container.querySelectorAll('.tag-filter-btn').forEach((btn) => {
      const isActive = btn.dataset.tag === activeTag;
      active.forEach((cls) => btn.classList.toggle(cls, isActive));
      inactive.forEach((cls) => btn.classList.toggle(cls, !isActive));
      btn.setAttribute('aria-pressed', String(isActive));
    });
  };

  document.querySelectorAll('[data-tag-filter]').forEach((container) => {
    const targetId = container.getAttribute('data-target');
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;

    const cards = target.querySelectorAll('[data-project-card]');

    container.querySelectorAll('.tag-filter-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const selectedTag = button.dataset.tag || 'all';

        cards.forEach((card) => {
          const cardTags = (card.getAttribute('data-tags') || '').split('|').filter(Boolean);
          const shouldShow = selectedTag === 'all' || cardTags.includes(selectedTag);
          card.classList.toggle('hidden', !shouldShow);
        });

        syncButtons(container, selectedTag);
      });
    });
  });
</script>

---
type TimelineItem = {
  title: string;
  subtitle: string;
  meta: string;
  location?: string;
  bullets: string[];
  chips?: string[];
};

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative ml-[5px] space-y-5 border-l border-border">
  {items.map((item, idx) => (
    <li class="reveal relative pl-6 sm:pl-8">
      <span
        class:list={[
          'absolute -left-[6px] top-7 h-[11px] w-[11px] rounded-full ring-4 ring-bg',
          idx === 0 ? 'bg-brand' : 'border-2 border-border bg-surface'
        ]}
        aria-hidden="true"
      ></span>
      <article class="surface-card p-5 transition hover:border-ink/20 sm:p-6">
        <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-display text-xl font-semibold tracking-tight text-ink">{item.title}</h3>
          <p class="font-mono text-[11px] uppercase tracking-wide text-brand">{item.meta}</p>
        </header>
        <p class="mt-1.5 text-[15px] font-semibold text-ink/80">{item.subtitle}</p>
        {item.location && <p class="mt-0.5 text-sm text-muted">{item.location}</p>}

        {item.bullets.length > 0 && (
          <ul class="mt-4 space-y-1.5 text-sm leading-relaxed text-muted">
            {item.bullets.map((bullet) => (
              <li class="relative pl-4 before:absolute before:left-0 before:top-[0.6em] before:h-1 before:w-1 before:rounded-full before:bg-muted/60">
                {bullet}
              </li>
            ))}
          </ul>
        )}

        {item.chips && item.chips.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {item.chips.map((chip) => (
              <span class="chip">{chip}</span>
            ))}
          </div>
        )}
      </article>
    </li>
  ))}
</ol>

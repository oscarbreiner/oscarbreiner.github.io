---
import { siteData } from '../data/site';
import { withBase } from '../utils/withBase';
import Icon from './Icon.astro';

const cvUrl = `${import.meta.env.BASE_URL}${siteData.cvPath}`;
const navItems = [
  { label: 'Research', href: withBase('/#projects') },
  { label: 'News', href: withBase('/#news') },
  { label: 'Honors', href: withBase('/#honors') },
  { label: 'Experience', href: withBase('/#experience') },
  { label: 'Education', href: withBase('/#education') },
  { label: 'All Projects', href: withBase('/projects') }
];
const initials = siteData.name
  .split(' ')
  .map((part) => part[0])
  .join('');
const iconButton =
  'rounded-lg border border-transparent p-2 text-muted transition hover:border-border hover:bg-surface hover:text-ink';
---

<nav class="sticky top-0 z-50 border-b border-border/70 bg-bg/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href={withBase('/')} class="flex items-center gap-2.5 text-ink">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent font-mono text-[11px] font-medium text-accent-fg">{initials}</span>
      <span class="text-sm font-semibold tracking-tight">{siteData.name}</span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm text-muted transition-colors hover:text-ink">{item.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-1 sm:gap-2">
      <button type="button" class={iconButton} aria-label="Toggle dark mode" data-theme-toggle>
        <Icon name="moon" class="h-5 w-5 dark:hidden" />
        <Icon name="sun" class="hidden h-5 w-5 dark:block" />
      </button>
      <a href={siteData.githubUrl} target="_blank" rel="noreferrer" aria-label="GitHub" class={iconButton}>
        <Icon name="github" class="h-5 w-5" />
      </a>
      <a href={siteData.linkedinUrl} target="_blank" rel="noreferrer" aria-label="LinkedIn" class={iconButton}>
        <Icon name="linkedin" class="h-5 w-5" />
      </a>
      {siteData.showCv && (
        <a href={cvUrl} download class="btn-primary ml-1 px-3 py-2 text-xs sm:px-4">
          Download CV
        </a>
      )}
    </div>
  </div>

  <div class="container-page flex gap-2 overflow-x-auto border-t border-border/70 py-2 lg:hidden">
    {navItems.map((item) => (
      <a href={item.href} class="whitespace-nowrap rounded-md px-2.5 py-1 text-xs font-medium text-muted hover:bg-surface hover:text-ink">
        {item.label}
      </a>
    ))}
  </div>
</nav>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {}
    });
  });
</script>

---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/withBase';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, image, imageFit, imageBg, badges, status, supervisors, date } = project.data;
const links = project.data.links ?? {};
const tagDataset = tags.map((tag) => tag.toLowerCase()).join('|');
---

<article
  class="project-card surface-card group row-span-6 grid cursor-pointer grid-rows-subgrid gap-0 overflow-hidden transition duration-200 hover:-translate-y-1 hover:border-ink/20 hover:shadow-card"
  data-project-card
  data-project-url={withBase(`/projects/${project.slug}`)}
  data-tags={tagDataset}
  tabindex="0"
  role="link"
>
  <div class="relative overflow-hidden border-b border-border" style={imageFit === 'contain' ? `background-color: ${imageBg ?? '#ffffff'}` : undefined}>
    <img
      src={withBase(image)}
      alt={title}
      class:list={['h-52 w-full transition duration-500 group-hover:scale-[1.03]', imageFit === 'contain' ? 'object-contain p-2' : 'object-cover']}
      loading="lazy"
    />
    <span class="absolute right-3 top-3 rounded-md bg-black/55 px-2 py-0.5 font-mono text-[11px] text-white backdrop-blur-sm">
      {date.getFullYear()}
    </span>
  </div>

  {/* Each block below is a row of the parent grid (subgrid), so titles, badges, descriptions, tags, and links line up across a row of cards. */}
  <div class="px-5 pt-5 sm:px-6 sm:pt-6">
    <h3 class="font-display text-xl font-semibold leading-snug tracking-tight text-ink">{title}</h3>
  </div>

  <div class="px-5 sm:px-6">
    {(badges.length > 0 || status) && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {badges.map((badge) => (
          <span class="rounded-md bg-accent px-2 py-0.5 text-[11px] font-semibold text-accent-fg">{badge}</span>
        ))}
        {status && (
          <span class="rounded-md bg-warn-bg px-2 py-0.5 text-[11px] font-semibold text-warn ring-1 ring-inset ring-warn/25">{status}</span>
        )}
      </div>
    )}
    {supervisors.length > 0 && (
      <p class="mt-2 text-xs text-muted">{supervisors.length > 1 ? 'Supervisors' : 'Supervisor'}: {supervisors.join(', ')}</p>
    )}
  </div>

  <p class="mt-3 px-5 text-sm leading-6 text-muted sm:px-6" data-project-description>{description}</p>

  <div class="mt-4 flex flex-wrap content-start gap-1.5 px-5 sm:px-6">
    {tags.map((tag) => (
      <span class="chip">{tag}</span>
    ))}
  </div>

  <div class="flex flex-wrap items-end gap-x-5 gap-y-2 px-5 pb-5 pt-5 text-sm sm:px-6 sm:pb-6">
    <a href={withBase(`/projects/${project.slug}`)} class="inline-flex items-center gap-1 font-semibold text-ink hover:text-brand">
      Details <Icon name="arrow-right" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" />
    </a>
    {links.github && (
      <a href={links.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 font-medium text-muted hover:text-ink">
        <Icon name="code" class="h-3.5 w-3.5" /> Code
      </a>
    )}
    {links.demo && (
      <a href={links.demo} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 font-medium text-muted hover:text-ink">
        <Icon name="external" class="h-3.5 w-3.5" /> Demo
      </a>
    )}
    {links.writeup && (
      <a href={links.writeup} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 font-medium text-muted hover:text-ink">
        <Icon name="doc" class="h-3.5 w-3.5" /> Write-up
      </a>
    )}
  </div>
</article>

<script>
  if (!window.__projectCardNavigationBound) {
    const isInteractive = (target) => target instanceof Element && !!target.closest('a, button, input, select, textarea, label');

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (isInteractive(target)) return;

      const card = target instanceof Element ? target.closest('[data-project-url]') : null;
      const href = card?.getAttribute('data-project-url');
      if (!href) return;

      window.location.href = href;
    });

    document.addEventListener('keydown', (event) => {
      if (!(event.target instanceof Element)) return;
      if (isInteractive(event.target)) return;

      const card = event.target.closest('[data-project-url]');
      const href = card?.getAttribute('data-project-url');
      if (!href) return;

      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        window.location.href = href;
      }
    });

    window.__projectCardNavigationBound = true;
  }
</script>

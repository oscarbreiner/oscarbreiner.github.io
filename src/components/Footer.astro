---
import { siteData } from '../data/site';
import Icon from './Icon.astro';

const cvUrl = `${import.meta.env.BASE_URL}${siteData.cvPath}`;
---

<footer class="mt-16 border-t border-border">
  <div class="container-page flex flex-col justify-between gap-6 py-10 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold text-ink">{siteData.name}</p>
      <p class="mt-1 text-sm text-muted">{siteData.tagline}</p>
      <p class="mt-3 text-xs text-muted">© {new Date().getFullYear()} {siteData.name} · {siteData.location}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <a href={siteData.githubUrl} target="_blank" rel="noreferrer" class="btn-secondary px-3 py-2">
        <Icon name="github" /> GitHub
      </a>
      <a href={siteData.linkedinUrl} target="_blank" rel="noreferrer" class="btn-secondary px-3 py-2">
        <Icon name="linkedin" /> LinkedIn
      </a>
      {siteData.email && (
        <a href={`mailto:${siteData.email}`} class="btn-secondary px-3 py-2">
          <Icon name="mail" /> {siteData.email}
        </a>
      )}
      {siteData.showCv && (
        <a href={cvUrl} download class="btn-primary px-3 py-2">
          Download CV
        </a>
      )}
    </div>
  </div>
</footer>

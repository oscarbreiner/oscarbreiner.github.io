---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { siteData } from '../../data/site';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return projects.map((project, idx) => ({
    params: { slug: project.slug },
    props: { project, newer: projects[idx - 1], older: projects[idx + 1] }
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  newer?: CollectionEntry<'projects'>;
  older?: CollectionEntry<'projects'>;
}

const { project, newer, older } = Astro.props as Props;
const { Content } = await render(project);
const { title, description, date, tags, image, imageFit, imageBg, badges, status, supervisors } = project.data;
const links = project.data.links ?? {};
const linkButtons = [
  links.github && { href: links.github, label: 'Code', icon: 'code' as const },
  links.writeup && { href: links.writeup, label: 'Write-up', icon: 'doc' as const },
  links.demo && { href: links.demo, label: 'Demo', icon: 'external' as const }
].filter(Boolean) as { href: string; label: string; icon: 'code' | 'doc' | 'external' }[];
---

<BaseLayout title={`${title} | ${siteData.name}`} description={description}>
  <Navbar />
  <main class="container-page section-spacing">
    <a href={withBase('/projects')} class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-ink">
      <Icon name="arrow-left" /> All projects
    </a>

    <header class="reveal mt-8 max-w-4xl">
      <p class="eyebrow">{[date.getFullYear(), ...tags].join(' · ')}</p>
      <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-ink sm:text-5xl">{title}</h1>
      {(badges.length > 0 || status) && (
        <div class="mt-5 flex flex-wrap gap-2">
          {badges.map((badge) => (
            <span class="rounded-md bg-accent px-2.5 py-1 text-xs font-semibold text-accent-fg">{badge}</span>
          ))}
          {status && <span class="rounded-md bg-warn-bg px-2.5 py-1 text-xs font-semibold text-warn ring-1 ring-inset ring-warn/25">{status}</span>}
        </div>
      )}
      <p class="mt-5 text-base leading-relaxed text-muted sm:text-lg">{description}</p>
      {linkButtons.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {linkButtons.map((link, idx) => (
            <a href={link.href} target="_blank" rel="noreferrer" class={idx === 0 ? 'btn-primary' : 'btn-secondary'}>
              <Icon name={link.icon} /> {link.label}
            </a>
          ))}
        </div>
      )}
    </header>

    <figure
      class="reveal mt-10 overflow-hidden rounded-2xl border border-border bg-subtle"
      style={imageFit === 'contain' ? `background-color: ${imageBg ?? '#ffffff'}` : undefined}
    >
      <img
        src={withBase(image)}
        alt={title}
        class:list={['w-full', imageFit === 'contain' ? 'mx-auto h-auto max-h-[32rem] object-contain p-4 sm:p-8' : 'h-64 object-cover sm:h-[28rem]']}
      />
    </figure>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-14">
      <div class="prose prose-slate max-w-3xl dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:text-brand prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-muted">
        <Content />
      </div>

      <aside class="order-first lg:order-none">
        <dl class="surface-card divide-y divide-border text-sm lg:sticky lg:top-24">
          <div class="px-5 py-4">
            <dt class="font-mono text-[11px] uppercase tracking-wide text-muted">Year</dt>
            <dd class="mt-1 font-medium text-ink">{date.getFullYear()}</dd>
          </div>
          {supervisors.length > 0 && (
            <div class="px-5 py-4">
              <dt class="font-mono text-[11px] uppercase tracking-wide text-muted">{supervisors.length > 1 ? 'Supervisors' : 'Supervisor'}</dt>
              {supervisors.map((name) => (
                <dd class="mt-1 font-medium text-ink">{name}</dd>
              ))}
            </div>
          )}
          <div class="px-5 py-4">
            <dt class="font-mono text-[11px] uppercase tracking-wide text-muted">Research areas</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <nav class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2" aria-label="More projects">
      {newer ? (
        <a href={withBase(`/projects/${newer.slug}`)} class="group surface-card p-5 transition hover:border-ink/20">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wide text-muted">
            <Icon name="arrow-left" class="h-3.5 w-3.5" /> Newer
          </span>
          <span class="mt-2 block font-semibold text-ink group-hover:text-brand">{newer.data.title}</span>
        </a>
      ) : (
        <div />
      )}
      {older && (
        <a href={withBase(`/projects/${older.slug}`)} class="group surface-card p-5 text-right transition hover:border-ink/20">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wide text-muted">
            Older <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </span>
          <span class="mt-2 block font-semibold text-ink group-hover:text-brand">{older.data.title}</span>
        </a>
      )}
    </nav>
  </main>
  <Footer />
</BaseLayout>

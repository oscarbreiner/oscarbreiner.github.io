---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import { techGroups } from '../data/tech';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { profileDetails } from '../data/profile';
import { honors } from '../data/honors';
import { news } from '../data/news';
import { withBase } from '../utils/withBase';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const experienceItems = experience.map((item) => ({
  title: item.company,
  subtitle: item.role,
  location: item.location,
  meta: `${item.start} — ${item.end}`,
  bullets: item.bullets,
  chips: item.tech
}));

const educationItems = education.map((item) => ({
  title: item.university,
  subtitle: item.degree,
  location: item.location,
  meta: `${item.start} — ${item.end}`,
  bullets: item.highlights,
  chips: []
}));

const personalGroups = [
  { title: 'Languages', items: profileDetails.languages },
  { title: 'Certificates', items: profileDetails.certificates },
  { title: 'Passions', items: profileDetails.passions }
];
---

<BaseLayout>
  <Navbar />
  <main class="container-page pb-8">
    <Hero />

    <section id="news" class="section-spacing border-t border-border">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,18rem)_1fr] lg:gap-14">
        <SectionHeader eyebrow="Updates" title="News" subtitle="Recent milestones in research and competitions." />
        <ol class="reveal divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
          {news.map((item) => {
            const Tag = item.href ? 'a' : 'div';
            return (
              <li>
                <Tag
                  href={item.href ? withBase(item.href) : undefined}
                  class:list={['group flex gap-4 px-5 py-4 sm:gap-6 sm:px-6', item.href && 'transition hover:bg-subtle']}
                >
                  <span class="w-16 shrink-0 pt-0.5 font-mono text-[11px] uppercase tracking-wide text-brand sm:w-20">{item.date}</span>
                  <span class="flex-1 text-sm leading-relaxed text-ink/85">{item.text}</span>
                  {item.href && (
                    <Icon name="arrow-right" class="mt-1 h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-ink" />
                  )}
                </Tag>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section id="projects" class="section-spacing border-t border-border">
      <div class="flex flex-wrap items-end justify-between gap-x-6">
        <SectionHeader
          eyebrow="Research"
          title="Research Highlights"
          subtitle="Selected projects in 3D vision, radar perception, and scientific machine learning."
        />
        <a href={withBase('/projects')} class="btn-secondary mb-7 sm:mb-10">
          All projects <Icon name="arrow-right" />
        </a>
      </div>
      <div id="featured-project-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="honors" class="section-spacing border-t border-border">
      <SectionHeader eyebrow="Recognition" title="Honors & Awards" subtitle="Competition results, scholarships, and recognitions." />
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {honors.map((honor) => {
          const Tag = honor.href ? 'a' : 'article';
          return (
            <Tag
              href={honor.href ? withBase(honor.href) : undefined}
              class:list={[
                'group reveal flex gap-4 rounded-2xl border border-border bg-surface p-5 sm:p-6',
                honor.href && 'transition hover:-translate-y-0.5 hover:border-ink/20 hover:shadow-card'
              ]}
            >
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gold-bg text-gold">
                <Icon name="trophy" class="h-5 w-5" />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h3 class="text-base font-semibold text-ink">{honor.title}</h3>
                  {honor.year && <p class="font-mono text-[11px] uppercase tracking-wide text-gold">{honor.year}</p>}
                </div>
                <p class="mt-1 text-sm leading-relaxed text-muted">{honor.detail}</p>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <section class="section-spacing border-t border-border">
      <div class="grid grid-cols-1 gap-12 xl:grid-cols-2 xl:gap-14">
        <div id="experience">
          <SectionHeader
            eyebrow="Career"
            title="Work Experience"
            subtitle="Machine learning systems built across research and industry teams."
          />
          <Timeline items={experienceItems} />
        </div>

        <div id="education">
          <SectionHeader eyebrow="Background" title="Education" subtitle="Academic foundation in vision, robotics, and machine learning." />
          <Timeline items={educationItems} />
        </div>
      </div>
    </section>

    <section id="stack" class="section-spacing border-t border-border">
      <SectionHeader eyebrow="Toolkit" title="Skills" subtitle="Research areas, languages, and tools I work with." />
      <dl class="reveal divide-y divide-border rounded-2xl border border-border bg-surface">
        {techGroups.map((group) => (
          <div class="grid gap-3 px-5 py-5 sm:grid-cols-[12rem_1fr] sm:gap-6 sm:px-6">
            <dt class="pt-1 text-sm font-semibold text-ink">{group.title}</dt>
            <dd class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="rounded-md border border-border bg-subtle px-2.5 py-1 text-[13px] text-ink/80">{item}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="section-spacing border-t border-border">
      <SectionHeader eyebrow="Beyond research" title="Personal" subtitle="Languages, certificates, and interests." />
      <div class="reveal grid grid-cols-1 divide-y divide-border rounded-2xl border border-border bg-surface md:grid-cols-3 md:divide-x md:divide-y-0">
        {personalGroups.map((group) => (
          <div class="p-5 sm:p-6">
            <h3 class="font-mono text-[11px] uppercase tracking-wide text-muted">{group.title}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-ink/85">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
